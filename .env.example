# 사용법: cp .env.example .env  →  아래 값을 채우기  →  chmod 600 .env
# (.env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않습니다. 절대 커밋하지 마세요)

# Gemini API 키 (Google AI Studio에서 발급). 비워 두면 규칙 기반으로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 기본 모델이 붐비면(503)·한도 초과(429)·응답 지연이면 차례로 쓸 예비 모델 (쉼표로 구분)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# auto: 키가 있으면 Gemini, 없으면 규칙 기반  /  gemini: 항상 Gemini  /  mock: 항상 규칙 기반
LLM_MODE=auto
# 속도: 묶음 동시 호출 수 / 응답 대기 시간(초) / 같은 모델 재시도 횟수
LLM_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=25
LLM_RETRY_ATTEMPTS=2
# 한 번 살펴볼 때 AI 분석 최대 시간(초). 넘으면 남은 파일은 규칙 기반으로 마무리
LLM_TOTAL_BUDGET_SECONDS=60
# 모델의 '생각' 정도 (minimal/low/medium/high). low가 빠르고 분류에는 충분
LLM_THINKING_LEVEL=low
# 같은 내용의 파일은 저장된 AI 결과를 다시 씀 (무료 한도 절약, 두 번째부터 즉시)
LLM_CACHE=true

# 우리 API를 보호하는 키 (대시보드가 X-API-Key 헤더로 보냄). 무작위 값: openssl rand -hex 16
SECRETARY_API_KEY=change-me-to-a-long-random-string

# 정리할 폴더. 처음에는 연습 폴더로 시험해 보세요.
#   Windows(Docker Desktop) 예: HOST_TARGET_DIR=C:/Users/내아이디/Downloads
#   WSL·리눅스 예:              HOST_TARGET_DIR=/home/내아이디/Downloads
HOST_TARGET_DIR=./demo/inbox

# 컨테이너가 내 파일을 옮길 수 있도록 내 계정 번호로 실행 (리눅스·WSL에서 id -u, id -g 결과)
APP_UID=1000
APP_GID=1000

# PostgreSQL 접속 정보 (docker compose가 db 컨테이너와 api에 함께 사용)
POSTGRES_USER=secretary
POSTGRES_PASSWORD=secretary-password
POSTGRES_DB=secretary

# Docker Hub에 이미지를 올릴 때: docker compose build && docker compose push
DOCKERHUB_USER=
TAG=0.1.0

# 폴더 감시 데몬 (watcher): 새 파일 확인 주기(초), AI 실패 시 다시 시도까지(초), 백그라운드 AI 분석 시간 제한(초)
WATCH_INTERVAL_SECONDS=15
WATCH_RETRY_SECONDS=600
WATCH_LLM_BUDGET_SECONDS=300
